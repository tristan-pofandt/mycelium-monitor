{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "demo/server.py"
      ],
      "port": 8200
    },
    {
      "name": "server",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "server/app.py"
      ],
      "port": 8100
